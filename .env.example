# RoleWise AI - Environment Configuration Template

# Server Port
PORT=3001

# JWT Secret & Expiry
JWT_SECRET=rolewise-academic-portal-jwt-secret-key-2026
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:5174

# Database Path (defaults to server/data/rolewise.db)
# DB_PATH=./server/data/rolewise.db

# File Upload Directory
# UPLOAD_DIR=./server/uploads

# =====================================================================
# Distributed Telemetry Sink Configuration (REQ-25)
# =====================================================================
# Target Telemetry Sink: 'sqlite' (default local prototype) | 'streaming' | 'hybrid'
TELEMETRY_SINK=sqlite

# Streaming Provider: 'kafka' (Apache Kafka) | 'kinesis' (AWS Kinesis)
TELEMETRY_STREAM_PROVIDER=kafka

# Apache Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=rolewise-telemetry-events

# AWS Kinesis Configuration
AWS_REGION=us-east-1
KINESIS_STREAM_NAME=rolewise-telemetry-stream

# Bounded Retry & Resilience Policy
STREAM_MAX_RETRIES=3
STREAM_RETRY_DELAY_MS=50
